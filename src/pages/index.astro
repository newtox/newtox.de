---
import Layout from "../layouts/Layout.astro";
import Profile from "../components/header/Profile.astro";
import Socials from "../components/header/Socials.astro";
import About from "../components/information/About.astro";
import Technologies from "../components/information/Technologies.astro";
import Footer from "../components/Footer.astro";
import { useTranslations } from "../i18n/translations.js";

const t = useTranslations("en");
---

<Layout title="newtox.de">
  <main class="min-h-screen flex flex-col items-center justify-center p-4 max-w-xl mx-auto my-auto gap-6">
    
    <div class="w-full">
      <Profile />
    </div>

    <div class="w-full flex flex-col gap-3">
      <button onclick="window.aboutModal.showModal()" class="w-full py-3 px-5 border border-white/20 bg-white/5 hover:bg-white/10 text-white font-roboto font-medium rounded-md transition cursor-pointer flex items-center justify-between shadow-lg">
        <span class="lang-key" data-key="about">{t("about")}</span>
        <span class="text-white/40">→</span>
      </button>

      <button onclick="window.socialsModal.showModal()" class="w-full py-3 px-5 border border-white/20 bg-white/5 hover:bg-white/10 text-white font-roboto font-medium rounded-md transition cursor-pointer flex items-center justify-between shadow-lg">
        <span class="lang-key" data-key="socials">{t("socials")}</span>
        <span class="text-white/40">→</span>
      </button>

      <button onclick="window.techModal.showModal()" class="w-full py-3 px-5 border border-white/20 bg-white/5 hover:bg-white/10 text-white font-roboto font-medium rounded-md transition cursor-pointer flex items-center justify-between shadow-lg">
        <span class="lang-key" data-key="technologies">{t("technologies")}</span>
        <span class="text-white/40">→</span>
      </button>

    <div class="w-full mt-2">
      <Footer />
    </div>

    <About />
    <Socials />
    <Technologies />

  </main>
</Layout>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(5px);
  }
</style>

<script>
  import deDict from "../i18n/de.json";
  import enDict from "../i18n/en.json";

  const dicts: Record<string, Record<string, string>> = { de: deDict, en: enDict };

  function updatePageLanguage(lang: string) {
    localStorage.setItem("preferred-lang", lang);
    const dict = dicts[lang] || dicts["en"];

    document.querySelectorAll(".lang-key").forEach((el) => {
      const key = el.getAttribute("data-key");
      if (key && dict[key]) {
        el.textContent = dict[key];
      }
    });

    const btnText = document.getElementById("langButtonText");
    if (btnText) {
      btnText.textContent = dict["switchLang"];
    }
  }

  const savedLang = localStorage.getItem("preferred-lang") || "en";
  updatePageLanguage(savedLang);

  document.getElementById("langToggle")?.addEventListener("click", () => {
    const currentLang = localStorage.getItem("preferred-lang") || "en";
    const newLang = currentLang === "en" ? "de" : "en";
    updatePageLanguage(newLang);
  });

  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (e) => {
      const rect = dialog.getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
        dialog.close();
      }
    });
  });
</script>