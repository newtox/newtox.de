---
import { projects } from '../data/projects'
import { icon } from '../data/icons'
import T from './T.astro'
---

<div class="grid">
  {projects.map((p, i) => (
    <article class:list={['card', { alt: i % 2 === 1 }]} style={`--tilt: ${i % 2 ? 0.8 : -0.8}deg`}>
      <header>
        <span class="badge">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d={icon(p.icon).path} />
          </svg>
        </span>
        <div>
          <h3>{p.name}</h3>
          <span class="tag">
            <span data-l="en">{p.tag.en}</span>
            <span data-l="de">{p.tag.de}</span>
          </span>
        </div>
      </header>
      <p>
        <span data-l="en">{p.desc.en}</span>
        <span data-l="de">{p.desc.de}</span>
      </p>
      <dl>
        <div>
          <dt>
            <T k="main" />
          </dt>
          <dd>{p.main}</dd>
        </div>
        <div>
          <dt>
            <T k="sub" />
          </dt>
          <dd>{p.sub}</dd>
        </div>
        <div>
          <dt>
            <T k="special" />
          </dt>
          <dd>{p.special}</dd>
        </div>
      </dl>
      <footer>
        <a href={p.repo} target="_blank" rel="noopener">
          <T k="code" /> ↗
        </a>
        {p.url && (
          <a href={p.url} target="_blank" rel="noopener">
            {p.url.replace('https://', '')} ↗
          </a>
        )}
      </footer>
    </article>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border-radius: 18px;
    background: #0007;
    border: 2px solid #fff1;
    transform: rotate(var(--tilt));
    transition:
      transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1),
      border-color 0.2s;
  }
  .card:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.02);
    border-color: #fff4;
  }
  header {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px 18px 12px 16px;
    border: 3px solid #000;
    flex: none;
    background: var(--mine);
    transition: background 0.4s;
  }
  .alt .badge {
    background: var(--theirs);
  }
  .badge svg {
    fill: #111;
  }
  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 900;
  }
  .tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff8;
  }
  p {
    margin: 0;
    color: #fffd;
    font-size: 0.92rem;
    line-height: 1.45;
    flex: 1;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 12px;
    background: #0006;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.82rem;
  }
  dt {
    font-weight: 900;
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #fff8;
    align-self: center;
  }
  dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  footer {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  footer a {
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    padding: 5px 12px;
    border-radius: 99px;
    border: 2px solid #fff3;
    background: #fff1;
  }
  footer a:hover {
    background: #fff;
    color: #111;
  }
</style>
