---
import type { Repo } from '../data/github'
import { icon } from '../data/icons'
import T from './T.astro'

interface Props {
  repos: Repo[]
}

const { repos } = Astro.props

const slug = (lang: string | null) =>
  (lang ?? '')
    .toLowerCase()
    .replace('c++', 'cplusplus')
    .replace('c#', 'dotnet')
    .replace(/[^a-z0-9]/g, '')
---

<div class="grid">
  {repos.map((r, i) => (
    <article class:list={['card', { alt: i % 2 === 1 }]} style={`--tilt: ${i % 2 ? 0.8 : -0.8}deg`}>
      <header>
        <span class="badge">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d={icon(slug(r.primary)).path} />
          </svg>
        </span>
        <h3>{r.name}</h3>
        {r.stars > 0 && <span class="stars">★ {r.stars}</span>}
      </header>
      {r.description && <p>{r.description}</p>}
      {r.topics.length > 0 && (
        <ul class="topics">
          {r.topics.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )}
      {r.languages.length > 0 && (
        <ul class="langs">
          {r.languages.map((l) => (
            <li>
              <i style={`background: ${l.color}`} />
              {l.name}
            </li>
          ))}
        </ul>
      )}
      <footer>
        <a href={r.url} target="_blank" rel="noopener">
          <T k="code" /> ↗
        </a>
        {r.homepage && (
          <a href={r.homepage} target="_blank" rel="noopener">
            {r.homepage.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗
          </a>
        )}
      </footer>
    </article>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border-radius: 18px;
    background: #0007;
    border: 2px solid #fff1;
    transform: rotate(var(--tilt));
    transition:
      transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1),
      border-color 0.2s;
  }
  .card:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.02);
    border-color: #fff4;
  }
  header {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 14px 18px 12px 16px;
    border: 3px solid #000;
    flex: none;
    background: var(--mine);
    transition: background 0.4s;
  }
  .alt .badge {
    background: var(--theirs);
  }
  .badge svg {
    fill: #111;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 900;
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .stars {
    font-size: 0.8rem;
    font-weight: 800;
    color: #fffb;
    white-space: nowrap;
  }
  p {
    margin: 0;
    color: #fffd;
    font-size: 0.92rem;
    line-height: 1.45;
    flex: 1;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .topics li {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--mine) 18%, transparent);
    color: #fffe;
  }
  .langs {
    gap: 12px;
  }
  .langs li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fffc;
  }
  .langs i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  footer {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  footer a {
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    padding: 5px 12px;
    border-radius: 99px;
    border: 2px solid #fff3;
    background: #fff1;
  }
  footer a:hover {
    background: #fff;
    color: #111;
  }
</style>
