---
import T from './T.astro'
import { siSpotify } from 'simple-icons'
---

<div class="lobby" id="lobby" data-status="offline">
  <div class="me">
    <div class="avatar">
      <img src="https://avatars.githubusercontent.com/u/39810250?s=160" alt="" width="72" height="72" data-avatar />
      <span class="dot"></span>
    </div>
    <div class="who">
      <strong data-name>Newtox</strong>
      <span class="status" data-status-text>
        <T k="connecting" />
      </span>
      <span class="bubble" data-custom hidden></span>
    </div>
  </div>

  <div class="activity">
    <div class="slot" data-spotify hidden>
      <img class="art" alt="" width="64" height="64" data-art />
      <div class="info">
        <span class="kicker">
          <T k="listening" />
          <svg class="platform" viewBox="0 0 24 24" aria-hidden="true"><path d={siSpotify.path}></path></svg>
        </span>
        <a class="title" target="_blank" rel="noopener" data-song></a>
        <span class="sub" data-artist></span>
        <div class="progress">
          <div data-progress></div>
        </div>
        <div class="times">
          <span data-pos></span>
          <span data-len></span>
        </div>
      </div>
    </div>

    <div class="acts" data-acts></div>
    <template data-act-tpl>
      <div class="slot">
        <div class="art-wrap">
          <img class="art" alt="" width="64" height="64" data-a-art />
          <div class="art placeholder" data-a-placeholder></div>
          <img class="small" alt="" width="24" height="24" data-a-small />
        </div>
        <div class="info">
          <span class="kicker">
            <span data-a-kicker></span>
            <svg class="platform" viewBox="0 0 24 24" aria-hidden="true" data-a-platform><path></path></svg>
          </span>
          <span class="title" data-a-name></span>
          <span class="sub" data-a-details></span>
          <span class="sub" data-a-state></span>
          <span class="clock" data-a-elapsed>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 15h10a1 1 0 1 1 0 2H7a1 1 0 1 1 0-2Z"></path></svg>
            <span data-a-time></span>
          </span>
          <div data-a-bar>
            <div class="progress">
              <div data-a-progress></div>
            </div>
            <div class="times">
              <span data-a-pos></span>
              <span data-a-len></span>
            </div>
          </div>
        </div>
      </div>
    </template>

    <p class="idle" data-idle hidden>
      <T k="nothingRunning" />
    </p>
    <p class="idle" data-missing hidden>
      <T k="notMonitored" />
    </p>
  </div>
</div>

<script>
  import { subscribe, activityImage, clock, type Activity, type Presence } from '../scripts/lanyard'
  import { bi } from '../scripts/lang'
  import { dict } from '../data/i18n'
  import {
    siApplemusic,
    siCrunchyroll,
    siDeezer,
    siKick,
    siNetflix,
    siSoundcloud,
    siTidal,
    siTwitch,
    siYoutube,
    siYoutubemusic,
  } from 'simple-icons'

  const platforms: [RegExp, string][] = [
    [/youtube music/i, siYoutubemusic.path],
    [/youtube/i, siYoutube.path],
    [/twitch/i, siTwitch.path],
    [/\bkick\b/i, siKick.path],
    [/soundcloud/i, siSoundcloud.path],
    [/netflix/i, siNetflix.path],
    [/crunchyroll/i, siCrunchyroll.path],
    [/apple music/i, siApplemusic.path],
    [/deezer/i, siDeezer.path],
    [/tidal/i, siTidal.path],
  ]

  const root = document.getElementById('lobby')!
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!
  let current: Presence | null = null
  let shown: { a: Activity; el: HTMLElement }[] = []

  const kinds: Record<number, { key: 'playing' | 'listeningTo' | 'watching' | 'competing'; icon: string }> = {
    0: { key: 'playing', icon: '🎮' },
    2: { key: 'listeningTo', icon: '🎧' },
    3: { key: 'watching', icon: '📺' },
    5: { key: 'competing', icon: '🏆' },
  }

  function isSpotify(a: Activity) {
    return a.id?.startsWith('spotify:') || (a.type === 2 && a.name === 'Spotify')
  }

  function part<T extends HTMLElement>(el: HTMLElement, sel: string) {
    return el.querySelector<T>(sel)!
  }

  function fill(el: HTMLElement, sel: string, text: string | undefined) {
    const t = part(el, sel)
    t.textContent = text ?? ''
    t.hidden = !text
  }

  function kicker(key: 'playing' | 'listeningTo' | 'watching' | 'competing', name: string) {
    const wrap = document.createElement('span')
    for (const l of ['en', 'de'] as const) {
      const s = document.createElement('span')
      s.dataset.l = l
      s.textContent = dict[l][key].replace('{name}', name)
      wrap.append(s)
    }
    return wrap
  }

  function card(a: Activity) {
    const tpl = $<HTMLTemplateElement>('[data-act-tpl]')
    const el = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement
    const kind = kinds[a.type]
    const img = activityImage(a)
    const art = part<HTMLImageElement>(el, '[data-a-art]')
    art.hidden = !img
    const ph = part(el, '[data-a-placeholder]')
    ph.hidden = !!img
    ph.textContent = kind.icon
    if (img) {
      art.onerror = () => {
        art.hidden = true
        ph.hidden = false
      }
      art.src = img
    }
    const small = part<HTMLImageElement>(el, '[data-a-small]')
    const smallSrc = activityImage(a, true)
    small.hidden = !smallSrc
    if (smallSrc) {
      small.onerror = () => (small.hidden = true)
      small.src = smallSrc
      if (a.assets?.small_text) small.title = a.assets.small_text
    }
    if (a.assets?.large_text) art.title = a.assets.large_text
    part(el, '[data-a-kicker]').replaceChildren(kicker(kind.key, a.name))
    const logo = a.type === 0 ? undefined : platforms.find(([re]) => re.test(a.name))?.[1]
    const platform = el.querySelector<SVGSVGElement>('[data-a-platform]')!
    platform.style.display = logo ? '' : 'none'
    if (logo) platform.querySelector('path')!.setAttribute('d', logo)
    const game = a.type === 0 || !a.details
    part(el, '[data-a-name]').textContent = game ? a.name : a.details!
    fill(el, '[data-a-details]', game ? a.details : undefined)
    fill(el, '[data-a-state]', a.state)
    return el
  }

  function setText(sel: string, text: string | undefined) {
    const el = $(sel)
    el.textContent = text ?? ''
    el.hidden = !text
  }

  function render(p: Presence) {
    current = p
    const status = p.discord_status ?? 'offline'
    root.dataset.status = status
    $('[data-status-text]').replaceChildren(bi(status))
    $('[data-name]').textContent = p.discord_user.global_name ?? p.discord_user.username
    if (p.discord_user.avatar) {
      const ext = p.discord_user.avatar.startsWith('a_') ? 'gif' : 'png'
      $<HTMLImageElement>('[data-avatar]').src =
        `https://cdn.discordapp.com/avatars/${p.discord_user.id}/${p.discord_user.avatar}.${ext}?size=160`
    }

    const custom = p.activities.find((a) => a.type === 4)
    const emoji = custom?.emoji && !custom.emoji.id ? custom.emoji.name + ' ' : ''
    setText('[data-custom]', custom?.state ? emoji + custom.state : undefined)

    const sp = p.listening_to_spotify ? p.spotify : null
    $('[data-spotify]').hidden = !sp
    if (sp) {
      $<HTMLImageElement>('[data-art]').src = sp.album_art_url
      const song = $<HTMLAnchorElement>('[data-song]')
      song.textContent = sp.song
      song.href = `https://open.spotify.com/track/${sp.track_id}`
      $('[data-artist]').textContent = sp.artist
    }

    const acts = p.activities.filter((a) => a.type in kinds && !isSpotify(a))
    shown = acts.map((a) => ({ a, el: card(a) }))
    $('[data-acts]').replaceChildren(...shown.map((x) => x.el))

    $('[data-idle]').hidden = !!sp || acts.length > 0
    tick()
  }

  function tick() {
    if (!current) return
    const now = Date.now()
    const sp = current.listening_to_spotify ? current.spotify : null
    if (sp) {
      const len = sp.timestamps.end - sp.timestamps.start
      const pos = now - sp.timestamps.start
      $('[data-progress]').style.width = Math.min(100, (pos / len) * 100) + '%'
      $('[data-pos]').textContent = clock(pos)
      $('[data-len]').textContent = clock(len)
    }
    for (const { a, el } of shown) {
      const start = a.timestamps?.start
      const end = a.timestamps?.end
      const bar = !!start && !!end && end > start
      part(el, '[data-a-bar]').hidden = !bar
      part(el, '[data-a-elapsed]').hidden = bar || !start
      if (bar) {
        const len = end - start
        const pos = Math.min(len, now - start)
        part(el, '[data-a-progress]').style.width = (pos / len) * 100 + '%'
        part(el, '[data-a-pos]').textContent = clock(pos)
        part(el, '[data-a-len]').textContent = clock(len)
      } else if (start) {
        part(el, '[data-a-time]').textContent = clock(now - start)
      }
    }
  }

  subscribe(render, () => {
    $('[data-status-text]').replaceChildren(bi('offline'))
    $('[data-missing]').hidden = false
  })
  setInterval(tick, 1000)
  setTimeout(() => {
    if (!current && $('[data-missing]').hidden) {
      $('[data-status-text]').replaceChildren(bi('offline'))
      $('[data-idle]').hidden = false
    }
  }, 6000)
</script>

<style>
  .lobby {
    --ring: #7a7686;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }
  .activity {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .lobby[data-status='online'] {
    --ring: #3ee07a;
  }
  .lobby[data-status='idle'] {
    --ring: #ffb21f;
  }
  .lobby[data-status='dnd'] {
    --ring: #ff4d4d;
  }
  [hidden] {
    display: none !important;
  }
  .me {
    flex: 0 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .avatar {
    position: relative;
    width: 72px;
    height: 72px;
    flex: none;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--ring);
    object-fit: cover;
    background: #222;
  }
  .dot {
    position: absolute;
    right: 0;
    bottom: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ring);
    border: 3px solid #14121b;
  }
  .lobby[data-status='online'] .dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--ring);
    animation: ping 1.8s ease-out infinite;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .who strong {
    font-size: 1.25rem;
    font-weight: 900;
  }
  .status {
    color: var(--ring);
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bubble {
    margin-top: 4px;
    align-self: flex-start;
    font-size: 0.85rem;
    background: #fff;
    color: #111;
    padding: 3px 10px;
    border-radius: 12px 12px 12px 3px;
    font-weight: 600;
  }
  .acts {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .acts:empty {
    display: none;
  }
  .slot {
    display: flex;
    gap: 12px;
    padding: 10px;
    border-radius: 16px;
    background: #0006;
    border: 2px solid #fff1;
  }
  .art {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    object-fit: cover;
    flex: none;
  }
  .art-wrap {
    position: relative;
    flex: none;
    min-width: 64px;
    height: 64px;
    align-self: flex-start;
  }
  .art-wrap .art {
    width: auto;
    min-width: 64px;
    max-width: 114px;
    border-radius: 8px;
  }
  .small {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #14121b;
    background: #14121b;
  }
  .placeholder {
    display: grid;
    place-items: center;
    font-size: 1.8rem;
    background: var(--theirs);
  }
  .info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: #dbdee1;
    margin-bottom: 2px;
  }
  .platform {
    width: 13px;
    height: 13px;
    flex: none;
    fill: #949ba4;
  }
  .clock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.82rem;
    color: #3ba55d;
    font-variant-numeric: tabular-nums;
  }
  .clock svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .title {
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a.title:hover {
    text-decoration: underline;
  }
  .sub {
    font-size: 0.85rem;
    color: #fffb;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mono,
  .times {
    font-variant-numeric: tabular-nums;
  }
  .progress {
    margin-top: 6px;
    height: 6px;
    border-radius: 99px;
    background: #fff2;
    overflow: hidden;
  }
  .progress div {
    height: 100%;
    width: 0;
    border-radius: 99px;
    background: var(--mine);
    transition: width 1s linear;
  }
  .times {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #fff8;
    margin-top: 2px;
  }
  .idle {
    margin: 0;
    color: #fff9;
    font-size: 0.9rem;
  }
  @keyframes ping {
    to {
      transform: scale(2);
      opacity: 0;
    }
  }
</style>
