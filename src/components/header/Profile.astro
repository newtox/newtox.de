---
import { useTranslations } from "../../i18n/translations.js";
const t = useTranslations("en");
---

<div class="w-full bg-white/5 border border-white/10 rounded-xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg backdrop-blur-md">
  <div class="flex items-center gap-4">
    <img 
      src="https://avatars.githubusercontent.com/u/39810250" 
      alt="Justin Lyschik" 
      class="w-16 h-16 rounded-full border-2 border-white/20 shadow-md object-cover"
    />
    <div>
      <h1 class="text-xl font-bold font-roboto text-white">Justin Lyschik</h1>
      <p class="text-xs text-white/60 font-roboto mt-0.5 lang-key" data-key="profileDesc"></p>
    </div>
  </div>

  <div>
    <button 
      id="langToggle" 
      class="px-3 py-1.5 border border-white/20 bg-white/5 hover:bg-white/10 text-white font-roboto text-xs font-medium rounded-md transition cursor-pointer shadow-md flex items-center gap-1.5"
    >
      <span>🌐</span>
      <span id="langButtonText" class="lang-key" data-key="switchLang"></span>
    </button>
  </div>
</div>

<script>
  const DISCORD_ID = "402483602094555138";
  
  async function fetchDiscordData() {
    try {
      const response = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`);
      const data = await response.json();
      
      if (data.success && data.data) {
        const user = data.data.discord_user;
        const discordStatus = data.data.discord_status;
        
        if (user.avatar) {
          const avatarUrl = `https://cdn.discordapp.com/avatars/${DISCORD_ID}/${user.avatar}.${user.avatar.startsWith("a_") ? "gif" : "png"}?size=256`;
          const imgElement = document.getElementById("discord-avatar") as HTMLImageElement;
          if (imgElement) imgElement.src = avatarUrl;
        }

        const statusDot = document.getElementById("status-dot");
        const statusPing = document.getElementById("status-ping");
        const statusText = document.getElementById("status-text");

        let colorClass = "bg-gray-500";
        let pingClass = "bg-gray-400";
        let text = "Offline";

        if (discordStatus === "online") {
          colorClass = "bg-green-500";
          pingClass = "bg-green-400";
          text = "Ready to code & play";
        } else if (discordStatus === "idle") {
          colorClass = "bg-amber-500";
          pingClass = "bg-amber-400";
          text = "Idle / AFK";
        } else if (discordStatus === "dnd") {
          colorClass = "bg-red-500";
          pingClass = "bg-red-400";
          text = "Do Not Disturb";
        }

        if (statusDot) statusDot.className = `relative inline-flex rounded-full h-3 w-3 ${colorClass}`;
        if (statusPing) statusPing.className = `animate-ping absolute inline-flex h-full w-full rounded-full ${pingClass} opacity-75`;
        if (statusText) statusText.textContent = text;
      }
    } catch (error) {
      console.error("Failed to fetch Discord status/avatar", error);
    }
  }

  fetchDiscordData();
</script>