---
interface Props {
  tilt?: number
  alt?: boolean
}

const { tilt = -2, alt = false } = Astro.props
---

<h2 class:list={{ alt }} style={`--tilt: ${tilt}deg`}>
  <slot />
</h2>

<style>
  h2 {
    display: inline-block;
    margin: 0 0 14px;
    padding: 4px 16px 6px;
    font-weight: 900;
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #111;
    background: var(--mine);
    border: 3px solid #000;
    border-radius: 10px 14px 9px 13px;
    transform: rotate(var(--tilt)) skewX(-6deg);
    box-shadow: 0 4px 0 #000;
    transition: background 0.4s;
  }
  h2.alt {
    background: var(--theirs);
  }
</style>
