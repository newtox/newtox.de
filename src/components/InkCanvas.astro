<canvas id="ink" aria-hidden="true"></canvas>

<script>
  import { mountInk } from '../scripts/ink'

  const canvas = document.getElementById('ink')
  const touch = matchMedia('(hover: none) and (pointer: coarse)').matches
  if (canvas instanceof HTMLCanvasElement && !touch) mountInk(canvas)
</script>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
  @media (hover: none) and (pointer: coarse) {
    canvas {
      display: none !important;
    }
  }
</style>
