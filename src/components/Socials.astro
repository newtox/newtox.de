---
import { socials } from '../data/socials'
import { icon } from '../data/icons'
---

<ul>
  {socials.map((s) => (
    <li>
      <a href={s.url} target={s.url.startsWith('mailto:') ? undefined : '_blank'} rel="noopener" aria-label={s.name}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={icon(s.icon).path} />
        </svg>
        <span>{s.name}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 10px;
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    border-radius: 16px;
    background: #0006;
    border: 2px solid #fff1;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.82rem;
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  svg {
    fill: currentColor;
  }
  a:hover {
    background: var(--mine);
    color: #111;
    border-color: #000;
    transform: translateY(-3px) rotate(-3deg);
  }
</style>
