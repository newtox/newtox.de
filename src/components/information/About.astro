<dialog id="aboutModal" class="bg-[#161b22] text-white p-6 rounded-xl border border-white/10 max-w-lg w-full shadow-2xl backdrop:bg-black/80">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-lg font-semibold font-roboto lang-key" data-key="aboutTitle"></h2>
    <form method="dialog"><button class="text-white/60 hover:text-white cursor-pointer text-base font-bold">✕</button></form>
  </div>
  <div class="font-roboto text-white/80 text-sm leading-relaxed">
    <p class="lang-key" data-key="aboutText"></p>
  </div>
</dialog>