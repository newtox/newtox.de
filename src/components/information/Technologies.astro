  {
    title: "Web Technologies",
    items: [
      { name: "HTML5", color: "hover:text-[#E34F26]", icon: "simple-icons:html5" },
      { name: "CSS3", color: "hover:text-[#1572B6]", icon: "simple-icons:css3" },
      { name: "Sass", color: "hover:text-[#CC6699]", icon: "simple-icons:sass" },
      { name: "Markdown", color: "hover:text-[#F5F5F5]", icon: "simple-icons:markdown" },
      { name: "JSON", color: "hover:text-[#F5F5F5]", icon: "simple-icons:json" },
