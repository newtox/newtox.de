    ],
  },
  {
    title: "Package Managers",
    items: [
      { name: "Composer", color: "hover:text-[#885630]", icon: "simple-icons:composer" },
      { name: "Chocolatey", color: "hover:text-[#80B5E3]", icon: "simple-icons:chocolatey" },
      { name: "DNF", color: "hover:text-[#294172]", icon: "mdi:package-variant" },
      { name: "Flatpak", color: "hover:text-[#4A90D9]", icon: "simple-icons:flatpak" },
      { name: "Nix", color: "hover:text-[#5277C3]", icon: "simple-icons:nixos" },
      { name: "NPM", color: "hover:text-[#CB3837]", icon: "simple-icons:npm" },
      { name: "NuGet", color: "hover:text-[#004880]", icon: "simple-icons:nuget" },
      { name: "pnpm", color: "hover:text-[#F69220]", icon: "simple-icons:pnpm" },
      { name: "Yarn", color: "hover:text-[#2C8EBB]", icon: "simple-icons:yarn" },
    ],
  },
  {
    title: "Utilities & System",
    items: [
      { name: "Discover", color: "hover:text-[#1D99F3]", icon: "mdi:apps" },
      { name: "Dolphin", color: "hover:text-[#1D99F3]", icon: "mdi:folder-outline" },
      { name: "Mullvad VPN", color: "hover:text-[#4746A4]", icon: "mdi:shield-lock-outline" },
      { name: "htop", color: "hover:text-[#2CE05C]", icon: "mdi:chart-line" },
