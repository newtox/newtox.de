      { name: "JavaScript", color: "hover:text-[#F7DF1E]", icon: "simple-icons:javascript" },
      { name: "Lua", color: "hover:text-[#2C2D72]", icon: "simple-icons:lua" },
      { name: "PHP", color: "hover:text-[#777BB4]", icon: "simple-icons:php" },
      { name: "Python", color: "hover:text-[#3776AB]", icon: "simple-icons:python" },
      { name: "TypeScript", color: "hover:text-[#3178C6]", icon: "simple-icons:typescript" },
