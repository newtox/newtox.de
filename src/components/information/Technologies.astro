    items: [
      { name: "Astro", color: "hover:text-[#FF5D01]", icon: "simple-icons:astro" },
      { name: "Bootstrap", color: "hover:text-[#7952B3]", icon: "simple-icons:bootstrap" },
      { name: "Flutter", color: "hover:text-[#02569B]", icon: "simple-icons:flutter" },
      { name: "Laravel", color: "hover:text-[#FF2D20]", icon: "simple-icons:laravel" },
      { name: "Next.js", color: "hover:text-[#F5F5F5]", icon: "simple-icons:nextdotjs" },
      { name: "Node.js", color: "hover:text-[#5FA04E]", icon: "simple-icons:nodedotjs" },
      { name: "PyTorch", color: "hover:text-[#EE4C2C]", icon: "simple-icons:pytorch" },
